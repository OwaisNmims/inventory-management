<%- include ('../partials/head') %>

<!--  BEGIN NAVBAR  -->
<%- include ('../partials/header') %>
<!--  END NAVBAR  -->

<!--  BEGIN MAIN CONTAINER  -->
<div class="main-container" id="container">
  <div class="overlay"></div>
  <div class="search-overlay"></div>

  <!--  BEGIN SIDEBAR  -->
  <%- include ('../partials/sidebar') %>
  <!--  END SIDEBAR  -->

  <!--  BEGIN CONTENT AREA  -->
  <div id="content" class="main-content">
    <div class="layout-px-spacing">
      <div class="middle-content container-xxl p-0">
        <!--  BEGIN BREADCRUMBS  -->
        <div class="secondary-nav">
          <div class="breadcrumbs-container" data-page-heading="Goods Return">
            <header class="header navbar navbar-expand-sm">
              <a href="javascript:void(0);" class="btn-toggle sidebarCollapse" data-placement="bottom">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                  class="feather feather-menu">
                  <line x1="3" y1="12" x2="21" y2="12"></line>
                  <line x1="3" y1="6" x2="21" y2="6"></line>
                  <line x1="3" y1="18" x2="21" y2="18"></line>
                </svg>
              </a>
              <div class="d-flex breadcrumb-content">
                <div class="page-header">
                  <div class="page-title"></div>
                  <nav class="breadcrumb-style-one" aria-label="breadcrumb">
                    <ol class="breadcrumb">
                      <li class="breadcrumb-item active">
                        <a href="/admin/dashboard">Dashboard</a>
                      </li>
                      <li class="breadcrumb-item active" aria-current="page">Goods Return</li>
                    </ol>
                  </nav>
                </div>
              </div>
            </header>
          </div>
        </div>
        <!--  END BREADCRUMBS  -->

        <div class="main-content">

          <!-- Company Selection -->
          <div class="table-template mb-4">
            <div class="table-header">
              <div class="table-title">
                <h3>Goods Return</h3>
              </div>
            </div>
            <div class="table-content">
              <div class="row g-3 align-items-end">
                <div class="col-md-3">
                  <label class="form-label fw-semibold">State</label>
                  <select class="form-select" id="gr-state-filter">
                    <option value="">All States</option>
                    <% if (states && states.length > 0) { %>
                      <% states.forEach(function(s) { %>
                        <option value="<%= s.id %>"><%= s.name %></option>
                      <% }); %>
                    <% } %>
                  </select>
                </div>
                <div class="col-md-3">
                  <label class="form-label fw-semibold">City</label>
                  <select class="form-select" id="gr-city-filter">
                    <option value="">All Cities</option>
                  </select>
                </div>
                <div class="col-md-6">
                  <label for="company-select" class="form-label fw-semibold">Company</label>
                  <select class="form-select" id="company-select">
                    <option value="">Choose a company to return from...</option>
                    <% if (companies && companies.length > 0) { %>
                      <% companies.forEach(function(company) { %>
                        <option value="<%= company.id %>"
                                data-type="<%= company.company_type %>"
                                data-state-lid="<%= company.state_lid || '' %>"
                                data-city-lid="<%= company.city_lid || '' %>">
                          <%= company.name %> (<%= company.company_code %>) &mdash; <%= company.mapped_units %> units mapped
                        </option>
                      <% }); %>
                    <% } else { %>
                      <option disabled>No companies with mapped inventory</option>
                    <% } %>
                  </select>
                  <% if (!companies || companies.length === 0) { %>
                    <small class="text-muted d-block mt-1">
                      <i class="fas fa-info-circle me-1"></i>No companies have mapped inventory to return.
                    </small>
                  <% } %>
                </div>
              </div>
            </div>
          </div>

          <!-- Last GR receipt banner -->
          <div id="last-gr-banner" class="d-none mb-3">
            <div class="alert alert-success d-flex align-items-center justify-content-between mb-0" role="alert">
              <span>
                <i class="fas fa-check-circle me-2"></i>
                Return complete &mdash; GR Receipt <strong id="last-gr-number"></strong>
              </span>
              <a id="last-gr-link" href="/admin/goods-return" class="btn btn-sm btn-outline-success ms-3">
                <i class="fas fa-receipt me-1"></i> View GR Receipts
              </a>
            </div>
          </div>

          <!-- Inventory Table — shown after company is selected -->
          <div id="inventory-section" class="d-none">
            <div class="table-template">
              <div class="table-header">
                <div class="table-title">
                  <h3>Mapped Inventory</h3>
                </div>
                <div class="table-actions d-flex align-items-center gap-3">
                  <span class="badge badge-info">Selected: <span id="selected-count">0</span> units</span>
                  <span class="badge badge-warning">Value: &#8377;<span id="total-value">0.00</span></span>
                  <button type="button" class="btn btn-warning" id="process-return" disabled>
                    <i class="fas fa-undo me-1"></i> Process Return
                  </button>
                </div>
              </div>

              <div class="table-content">
                <div class="mb-3">
                  <input type="text" id="inv-search" class="form-control"
                         placeholder="Search by product name or code...">
                </div>
                <div class="table-responsive">
                  <table class="table table-bordered" id="inventory-table">
                    <thead class="table-dark">
                      <tr>
                        <th style="width: 50px;" class="text-center">
                          <input type="checkbox" id="select-all" class="form-check-input">
                        </th>
                        <th>Product</th>
                        <th>Code</th>
                        <th>Label</th>
                        <th class="text-center">Mapped Units</th>
                        <th>Value / Unit</th>
                        <th style="width: 130px;">Qty to Return</th>
                        <th>Subtotal</th>
                      </tr>
                    </thead>
                    <tbody id="inventory-tbody">
                      <tr>
                        <td colspan="8" class="text-center py-3">
                          <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                          Loading inventory...
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </div>
                <div id="inv-pagination" class="mt-3"></div>
              </div>
            </div>
          </div>

          <!-- GR Receipts History -->
          <div class="table-template mt-4">
            <div class="table-header">
              <div class="table-title">
                <h3>GR Receipt History</h3>
              </div>
              <div class="table-actions d-flex align-items-center gap-3">
                <!-- Filters -->
                <input type="text" id="filter-receipt" class="form-control form-control-sm"
                       placeholder="GR Receipt #" style="width:140px;">
                <input type="date" class="form-control form-control-sm" id="filter-date-from" style="width:140px;">
                <input type="date" class="form-control form-control-sm" id="filter-date-to" style="width:140px;">
                <button class="btn btn-primary btn-sm" id="btn-filter">
                  <i class="fas fa-search"></i>
                </button>
              </div>
            </div>
            <div class="table-content">
              <div class="table-responsive">
                <table class="table table-bordered" id="gr-table">
                  <thead class="table-dark">
                    <tr>
                      <th style="width:40px;"></th>
                      <th class="sortable" data-sort="receipt_number" style="cursor:pointer;">GR Receipt # <i class="sort-icon fas fa-sort ms-1"></i></th>
                      <th class="sortable" data-sort="company_name" style="cursor:pointer;">From Company <i class="sort-icon fas fa-sort ms-1"></i></th>
                      <th class="sortable" data-sort="return_date" style="cursor:pointer;">Return Date <i class="sort-icon fas fa-sort ms-1"></i></th>
                      <th class="sortable text-center" data-sort="total_units" style="cursor:pointer;">Units <i class="sort-icon fas fa-sort ms-1"></i></th>
                      <th class="sortable text-end" data-sort="total_amount" style="cursor:pointer;">Value <i class="sort-icon fas fa-sort ms-1"></i></th>
                    </tr>
                  </thead>
                  <tbody id="gr-tbody">
                    <tr>
                      <td colspan="6" class="text-center py-3">
                        <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                        Loading receipts...
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
              <div class="d-flex justify-content-between align-items-center mt-3 d-none" id="gr-pagination-wrapper">
                <small class="text-muted" id="gr-pagination-info"></small>
                <div class="d-flex align-items-center gap-2">
                  <select class="form-select form-select-sm" id="gr-per-page" style="width:75px;">
                    <option value="10">10</option>
                    <option value="20" selected>20</option>
                    <option value="50">50</option>
                  </select>
                  <small class="text-muted">per page</small>
                  <nav><ul class="pagination pagination-sm mb-0 ms-2" id="gr-pagination-controls"></ul></nav>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
  <!--  END CONTENT AREA  -->
</div>
<!-- END MAIN CONTAINER -->

<%- include ('../partials/footer') %>

<script>
$(document).ready(function() {
    // ── State ───────────────────────────────────────────────────
    let selectedItems    = new Map();  // key = product_id + '_' + label
    let currentCompanyId = null;
    let currentPage      = 1;
    let currentLimit     = 25;
    let currentSearch    = '';
    let searchTimer      = null;
    let grCurrentPage      = 1;
    let grCurrentLimit     = 20;
    let grCurrentSortBy    = 'return_date';
    let grCurrentSortOrder = 'DESC';

    const grCities = JSON.parse('<%- JSON.stringify(cities || []) %>');

    // ── State / city / company cascade ───────────────────────────
    $('#gr-state-filter').on('change', function() {
        const stateId = $(this).val();
        const citySel = $('#gr-city-filter');
        citySel.html('<option value="">All Cities</option>');
        if (stateId) {
            grCities.filter(c => c.state_lid == stateId).forEach(function(c) {
                citySel.append('<option value="' + c.id + '">' + c.name + '</option>');
            });
        }
        filterCompanies();
    });

    $('#gr-city-filter').on('change', filterCompanies);

    function filterCompanies() {
        const selState = $('#gr-state-filter').val();
        const selCity  = $('#gr-city-filter').val();
        $('#company-select option').each(function() {
            if (!$(this).val()) return;
            let show = true;
            if (selState && $(this).data('state-lid') != selState) show = false;
            if (selCity  && $(this).data('city-lid')  != selCity)  show = false;
            $(this).prop('hidden', !show);
        });
        const cur = $('#company-select').val();
        if (cur && $('#company-select option[value="' + cur + '"]:not([hidden])').length === 0) {
            $('#company-select').val('').trigger('change');
        }
    }

    // ── Company change ───────────────────────────────────────────
    $('#company-select').on('change', function() {
        const companyId = $(this).val();
        if (companyId) {
            selectedItems.clear();
            currentPage   = 1;
            currentSearch = '';
            $('#inv-search').val('');
            $('#inventory-section').removeClass('d-none');
            loadInventory(companyId, 1, '');
        } else {
            $('#inventory-section').addClass('d-none');
            resetReturnState();
        }
    });

    // ── Search ───────────────────────────────────────────────────
    $('#inv-search').on('input', function() {
        clearTimeout(searchTimer);
        const q = $(this).val();
        searchTimer = setTimeout(function() {
            if (currentCompanyId) {
                currentSearch = q;
                currentPage   = 1;
                loadInventory(currentCompanyId, 1, q);
            }
        }, 300);
    });

    // ── Pagination click ─────────────────────────────────────────
    $(document).on('click', '#inv-pagination .page-link', function(e) {
        e.preventDefault();
        const page = parseInt($(this).data('page'));
        if (page && currentCompanyId) loadInventory(currentCompanyId, page, currentSearch);
    });

    $(document).on('change', '#inv-per-page', function() {
        currentLimit = parseInt($(this).val());
        if (currentCompanyId) loadInventory(currentCompanyId, 1, currentSearch);
    });

    // ── Load mapped inventory for company ────────────────────────
    function loadInventory(companyId, page, search) {
        currentCompanyId = companyId;
        currentPage      = page;
        currentSearch    = search;

        $('#inventory-tbody').html(
            '<tr><td colspan="8" class="text-center py-3">' +
            '<div class="spinner-border spinner-border-sm me-2"></div>Loading...</td></tr>'
        );
        $('#inv-pagination').empty();

        $.ajax({
            url: '/admin/sales/inventory/' + companyId,
            method: 'GET',
            data: { page: page, limit: currentLimit, search: search },
            success: function(response) {
                if (response.status === 200) {
                    renderInventoryTable(response.data);
                    renderPagination(response.pagination);
                    updateTotals();
                } else {
                    $('#inventory-tbody').html(
                        '<tr><td colspan="8" class="text-center text-danger py-3">' +
                        '<i class="fas fa-exclamation-circle me-1"></i>Error loading inventory</td></tr>'
                    );
                }
            },
            error: function() {
                $('#inventory-tbody').html(
                    '<tr><td colspan="8" class="text-center text-danger py-3">' +
                    '<i class="fas fa-exclamation-circle me-1"></i>Failed to load inventory</td></tr>'
                );
            }
        });
    }

    // ── Render inventory table ───────────────────────────────────
    function renderInventoryTable(items) {
        const tbody = $('#inventory-tbody');
        tbody.empty();

        if (items.length === 0) {
            tbody.html(
                '<tr><td colspan="8" class="text-center py-3 text-muted">' +
                '<i class="fas fa-inbox me-1"></i>No mapped inventory to return</td></tr>'
            );
            return;
        }

        items.forEach(function(item) {
            const key        = item.product_id + '_' + item.label;
            const sel        = selectedItems.get(key);
            const isChecked  = !!sel;
            const qty        = sel ? sel.quantity : 1;
            const labelClass = item.label === 'NEW' ? 'badge-success' : 'badge-secondary';
            const subtotal   = isChecked ? (item.price * qty).toFixed(2) : '0.00';

            tbody.append(
                '<tr data-key="' + key + '"' +
                    ' data-mapping-ids=\'' + JSON.stringify(item.mapping_ids) + '\'' +
                    ' data-price="' + item.price + '"' +
                    ' data-available="' + item.available_units + '">' +
                    '<td class="text-center align-middle">' +
                        '<input type="checkbox" class="form-check-input item-checkbox"' + (isChecked ? ' checked' : '') + '>' +
                    '</td>' +
                    '<td class="align-middle">' + item.product_name + '</td>' +
                    '<td class="align-middle"><code>' + item.product_code + '</code></td>' +
                    '<td class="align-middle"><span class="badge ' + labelClass + '">' + item.label + '</span></td>' +
                    '<td class="align-middle text-center"><span class="badge badge-warning">' + item.available_units + '</span></td>' +
                    '<td class="align-middle"><strong>&#8377;' + parseFloat(item.price).toFixed(2) + '</strong></td>' +
                    '<td class="align-middle">' +
                        '<input type="number" class="form-control form-control-sm quantity-input" ' +
                               'min="1" max="' + item.available_units + '" value="' + qty + '"' +
                               (isChecked ? '' : ' disabled') + '>' +
                    '</td>' +
                    '<td class="align-middle"><strong>&#8377;<span class="subtotal">' + subtotal + '</span></strong></td>' +
                '</tr>'
            );
        });

        const total   = items.length;
        const checked = items.filter(i => selectedItems.has(i.product_id + '_' + i.label)).length;
        $('#select-all').prop('checked', total > 0 && checked === total);
    }

    // ── Pagination ───────────────────────────────────────────────
    function renderPagination(pag) {
        const container = $('#inv-pagination');
        container.empty();
        if (!pag) return;

        const limitOpts = [10, 25, 50, 100];
        let perPageSel = '<select class="form-select form-select-sm" id="inv-per-page" style="width:75px;">';
        limitOpts.forEach(function(o) {
            perPageSel += '<option value="' + o + '"' + (o === currentLimit ? ' selected' : '') + '>' + o + '</option>';
        });
        perPageSel += '</select>';

        let html = '<div class="d-flex justify-content-between align-items-center mt-1">';
        html += '<small class="text-muted">Page ' + pag.currentPage + ' of ' + pag.totalPages + ' &mdash; ' + pag.totalRecords + ' product(s)</small>';
        html += '<div class="d-flex align-items-center gap-2">' + perPageSel + '<small class="text-muted">per page</small>';

        if (pag.totalPages > 1) {
            html += '<nav><ul class="pagination pagination-sm mb-0 ms-2">';
            html += '<li class="page-item' + (pag.hasPrevPage ? '' : ' disabled') + '">' +
                    '<a class="page-link" href="#" data-page="' + (pag.currentPage - 1) + '">Prev</a></li>';
            const start = Math.max(1, pag.currentPage - 2);
            const end   = Math.min(pag.totalPages, pag.currentPage + 2);
            for (let p = start; p <= end; p++) {
                html += '<li class="page-item' + (p === pag.currentPage ? ' active' : '') + '">' +
                        '<a class="page-link" href="#" data-page="' + p + '">' + p + '</a></li>';
            }
            html += '<li class="page-item' + (pag.hasNextPage ? '' : ' disabled') + '">' +
                    '<a class="page-link" href="#" data-page="' + (pag.currentPage + 1) + '">Next</a></li>';
            html += '</ul></nav>';
        }
        html += '</div></div>';
        container.html(html);
    }

    // ── Checkbox change ──────────────────────────────────────────
    $(document).on('change', '.item-checkbox', function() {
        const row      = $(this).closest('tr');
        const key      = row.data('key');
        const qtyInput = row.find('.quantity-input');

        if ($(this).is(':checked')) {
            qtyInput.prop('disabled', false);
            const qty = parseInt(qtyInput.val()) || 1;
            selectedItems.set(key, {
                mappingIds:     row.data('mapping-ids'),
                availableUnits: parseInt(row.data('available')),
                price:          parseFloat(row.data('price')),
                quantity:       qty
            });
        } else {
            qtyInput.prop('disabled', true).val(1);
            selectedItems.delete(key);
        }
        updateTotals();
    });

    // ── Select all ───────────────────────────────────────────────
    $('#select-all').on('change', function() {
        const checked = $(this).is(':checked');
        $('.item-checkbox').each(function() {
            const row = $(this).closest('tr');
            const key = row.data('key');
            $(this).prop('checked', checked);
            const qtyInput = row.find('.quantity-input');
            if (checked) {
                qtyInput.prop('disabled', false);
                const qty = parseInt(qtyInput.val()) || 1;
                selectedItems.set(key, {
                    mappingIds:     row.data('mapping-ids'),
                    availableUnits: parseInt(row.data('available')),
                    price:          parseFloat(row.data('price')),
                    quantity:       qty
                });
            } else {
                qtyInput.prop('disabled', true).val(1);
                selectedItems.delete(key);
            }
        });
        updateTotals();
    });

    // ── Quantity input ───────────────────────────────────────────
    $(document).on('input', '.quantity-input', function() {
        const row = $(this).closest('tr');
        const key = row.data('key');
        const max = parseInt($(this).attr('max'));
        let val   = parseInt($(this).val());
        if (!val || val < 1) { $(this).val(1); val = 1; }
        else if (val > max)  { $(this).val(max); val = max; }
        if (selectedItems.has(key)) selectedItems.get(key).quantity = val;
        updateTotals();
    });

    // ── Totals ───────────────────────────────────────────────────
    function updateTotals() {
        let selectedCount = 0;
        let totalValue    = 0;

        selectedItems.forEach(function(item) {
            const qty = item.quantity || 1;
            selectedCount += qty;
            totalValue    += item.price * qty;
        });

        $('.item-checkbox').each(function() {
            const row = $(this).closest('tr');
            const key = row.data('key');
            if ($(this).is(':checked') && selectedItems.has(key)) {
                const item = selectedItems.get(key);
                row.find('.subtotal').text((item.price * item.quantity).toFixed(2));
            } else {
                row.find('.subtotal').text('0.00');
            }
        });

        $('#selected-count').text(selectedCount);
        $('#total-value').text(totalValue.toFixed(2));
        $('#process-return').prop('disabled', selectedCount === 0);
    }

    function resetReturnState() {
        selectedItems.clear();
        currentPage   = 1;
        currentLimit  = 25;
        currentSearch = '';
        $('#selected-count').text(0);
        $('#total-value').text('0.00');
        $('#process-return').prop('disabled', true);
        $('#select-all').prop('checked', false);
        $('#inv-pagination').empty();
    }

    // ── Process Return ───────────────────────────────────────────
    $('#process-return').on('click', function() {
        const mappingIds = [];

        selectedItems.forEach(function(item) {
            const qty = item.quantity || 1;
            for (let i = 0; i < qty && i < item.mappingIds.length; i++) {
                mappingIds.push(item.mappingIds[i]);
            }
        });

        if (mappingIds.length === 0) return;

        const totalValue = $('#total-value').text();

        if (!confirm('Return ' + mappingIds.length + ' unit(s) worth \u20B9' + totalValue + ' back to SELF?')) return;

        const btn = $(this);
        btn.prop('disabled', true).html('<div class="spinner-border spinner-border-sm me-1"></div> Processing...');

        $.ajax({
            method: 'POST',
            url: '/admin/inventory-mapping/transfer-to-self',
            headers: { 'Content-Type': 'application/json' },
            data: JSON.stringify({ mappingIds: mappingIds }),
            success: function(response) {
                if (response.status === 200) {
                    const grNumber = response.data.gr_receipt_number;
                    createAlert({
                        title: 'RETURN SUCCESSFUL',
                        msg: 'Returned ' + response.data.total_units + ' unit(s) to SELF \u2014 GR: ' + grNumber,
                        type: 'positive'
                    });
                    $('#last-gr-number').text(grNumber);
                    $('#last-gr-banner').removeClass('d-none');

                    // Clear selection and reload
                    selectedItems.clear();
                    currentPage = 1;
                    $('#select-all').prop('checked', false);
                    btn.html('<i class="fas fa-undo me-1"></i> Process Return');
                    loadInventory(currentCompanyId, 1, currentSearch);
                    loadGrReceipts(1);
                } else {
                    createAlert({
                        title: 'RETURN FAILED',
                        msg: response.data.message || 'Failed to process return',
                        type: 'negative'
                    });
                    btn.prop('disabled', false).html('<i class="fas fa-undo me-1"></i> Process Return');
                }
            },
            error: function() {
                createAlert({ title: 'ERROR', msg: 'An error occurred', type: 'negative' });
                btn.prop('disabled', false).html('<i class="fas fa-undo me-1"></i> Process Return');
            }
        });
    });

    // ── GR Receipts history ──────────────────────────────────────
    loadGrReceipts(1);

    $('#btn-filter').on('click', function() { loadGrReceipts(1); });
    $('#filter-receipt').on('keydown', function(e) { if (e.key === 'Enter') loadGrReceipts(1); });
    $('#gr-per-page').on('change', function() {
        grCurrentLimit = parseInt($(this).val());
        loadGrReceipts(1);
    });

    // Column sort for GR table
    $(document).on('click', '#gr-table thead .sortable', function() {
        const field = $(this).data('sort');
        if (grCurrentSortBy === field) {
            grCurrentSortOrder = grCurrentSortOrder === 'ASC' ? 'DESC' : 'ASC';
        } else {
            grCurrentSortBy    = field;
            grCurrentSortOrder = 'ASC';
        }
        $('#gr-table thead .sortable .sort-icon')
            .removeClass('fa-sort-up fa-sort-down').addClass('fa-sort');
        $(this).find('.sort-icon')
            .removeClass('fa-sort')
            .addClass(grCurrentSortOrder === 'ASC' ? 'fa-sort-up' : 'fa-sort-down');
        loadGrReceipts(1);
    });

    function loadGrReceipts(page) {
        grCurrentPage = page;
        $('#gr-tbody').html(
            '<tr><td colspan="6" class="text-center py-3">' +
            '<div class="spinner-border spinner-border-sm me-2"></div>Loading...</td></tr>'
        );

        $.ajax({
            url: '/admin/goods-return/list',
            method: 'GET',
            data: {
                page:      page,
                limit:     grCurrentLimit,
                receipt:   $('#filter-receipt').val().trim(),
                dateFrom:  $('#filter-date-from').val(),
                dateTo:    $('#filter-date-to').val(),
                sortBy:    grCurrentSortBy,
                sortOrder: grCurrentSortOrder
            },
            success: function(response) {
                if (response.status === 200) {
                    renderGrTable(response.data.items);
                    renderGrPagination(response.data.pagination);
                } else { showGrError(); }
            },
            error: showGrError
        });
    }

    function renderGrTable(items) {
        const tbody = $('#gr-tbody');
        tbody.empty();
        if (items.length === 0) {
            tbody.html('<tr><td colspan="6" class="text-center py-3 text-muted">' +
                '<i class="fas fa-inbox me-1"></i>No return receipts yet</td></tr>');
            return;
        }
        items.forEach(function(r) {
            const date = new Date(r.return_date).toLocaleDateString('en-IN', {
                day: '2-digit', month: 'short', year: 'numeric',
                hour: '2-digit', minute: '2-digit'
            });
            tbody.append(
                '<tr class="gr-row" style="cursor:pointer;" data-gr-id="' + r.id + '">' +
                    '<td class="text-center align-middle">' +
                        '<i class="fas fa-chevron-right expand-icon text-muted" style="transition:transform .2s;font-size:11px;"></i>' +
                    '</td>' +
                    '<td class="align-middle"><code>' + r.receipt_number + '</code></td>' +
                    '<td class="align-middle">' + r.company_name + ' <small class="text-muted">(' + r.company_code + ')</small></td>' +
                    '<td class="align-middle"><small>' + date + '</small></td>' +
                    '<td class="align-middle text-center"><span class="badge badge-info">' + r.total_units + '</span></td>' +
                    '<td class="align-middle text-end"><strong>&#8377;' + parseFloat(r.total_amount).toFixed(2) + '</strong></td>' +
                '</tr>' +
                '<tr class="items-row d-none" id="gr-items-' + r.id + '">' +
                    '<td colspan="6" class="p-0">' +
                        '<div class="p-3 bg-light border-top">' +
                            '<div class="items-placeholder text-center py-2 text-muted">' +
                                '<div class="spinner-border spinner-border-sm me-1"></div> Loading items...' +
                            '</div>' +
                        '</div>' +
                    '</td>' +
                '</tr>'
            );
        });
    }

    $(document).on('click', '.gr-row', function() {
        const grId    = $(this).data('gr-id');
        const itemRow = $('#gr-items-' + grId);
        const icon    = $(this).find('.expand-icon');
        const isOpen  = !itemRow.hasClass('d-none');

        if (isOpen) { itemRow.addClass('d-none'); icon.css('transform', 'rotate(0deg)'); return; }

        $('.items-row').addClass('d-none');
        $('.expand-icon').css('transform', 'rotate(0deg)');
        itemRow.removeClass('d-none');
        icon.css('transform', 'rotate(90deg)');

        if (itemRow.find('.items-placeholder').length) { loadGrItems(grId, itemRow); }
    });

    function loadGrItems(grId, container) {
        $.ajax({
            url: '/admin/goods-return/' + grId,
            method: 'GET',
            success: function(response) {
                if (response.status === 200) { renderGrItems(container, response.data.items); }
                else { container.find('.p-3').html('<p class="text-danger small mb-0">Error loading items</p>'); }
            },
            error: function() { container.find('.p-3').html('<p class="text-danger small mb-0">Failed to load</p>'); }
        });
    }

    function renderGrItems(container, items) {
        if (items.length === 0) {
            container.find('.p-3').html('<p class="text-muted small mb-0"><i class="fas fa-inbox me-1"></i>No items</p>');
            return;
        }
        let html = '<table class="table table-sm table-bordered mb-0"><thead><tr>' +
            '<th>Product</th><th>Code</th><th>Label</th><th class="text-end">Value at Return</th>' +
            '</tr></thead><tbody>';
        items.forEach(function(item) {
            const lc = item.label === 'NEW' ? 'badge-success' : 'badge-secondary';
            html += '<tr>' +
                '<td>' + item.product_name + '</td>' +
                '<td><code>' + item.product_code + '</code></td>' +
                '<td><span class="badge ' + lc + '">' + (item.label || '-') + '</span></td>' +
                '<td class="text-end"><strong>&#8377;' + parseFloat(item.product_price).toFixed(2) + '</strong></td>' +
                '</tr>';
        });
        html += '</tbody></table>';
        container.find('.p-3').html(html);
    }

    function renderGrPagination(pag) {
        const wrapper  = $('#gr-pagination-wrapper');
        const info     = $('#gr-pagination-info');
        const controls = $('#gr-pagination-controls');
        if (pag.totalRecords === 0) { wrapper.addClass('d-none'); return; }
        wrapper.removeClass('d-none');
        const start = (pag.currentPage - 1) * pag.limit + 1;
        const end   = Math.min(pag.currentPage * pag.limit, pag.totalRecords);
        info.text('Showing ' + start + '–' + end + ' of ' + pag.totalRecords);
        controls.empty();
        if (pag.hasPrevPage) controls.append('<li class="page-item"><a class="page-link" href="#" data-gr-page="' + (pag.currentPage - 1) + '">&laquo;</a></li>');
        for (let p = Math.max(1, pag.currentPage - 2); p <= Math.min(pag.totalPages, pag.currentPage + 2); p++) {
            controls.append('<li class="page-item' + (p === pag.currentPage ? ' active' : '') + '"><a class="page-link" href="#" data-gr-page="' + p + '">' + p + '</a></li>');
        }
        if (pag.hasNextPage) controls.append('<li class="page-item"><a class="page-link" href="#" data-gr-page="' + (pag.currentPage + 1) + '">&raquo;</a></li>');
    }

    $(document).on('click', '#gr-pagination-controls .page-link', function(e) {
        e.preventDefault();
        loadGrReceipts(parseInt($(this).data('gr-page')));
    });

    function showGrError() {
        $('#gr-tbody').html('<tr><td colspan="6" class="text-center text-danger py-3">' +
            '<i class="fas fa-exclamation-circle me-1"></i>Error loading receipts</td></tr>');
    }
});
</script>
