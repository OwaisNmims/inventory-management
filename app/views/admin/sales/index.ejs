<%- include ('../partials/head') %>

<!--  BEGIN NAVBAR  -->
<%- include ('../partials/header') %>
<!--  END NAVBAR  -->

<!--  BEGIN MAIN CONTAINER  -->
<div class="main-container" id="container">
  <div class="overlay"></div>
  <div class="search-overlay"></div>

  <!--  BEGIN SIDEBAR  -->
  <%- include ('../partials/sidebar') %>
  <!--  END SIDEBAR  -->

  <!--  BEGIN CONTENT AREA  -->
  <div id="content" class="main-content">
    <div class="layout-px-spacing">
      <div class="middle-content container-xxl p-0">
        <!--  BEGIN BREADCRUMBS  -->
        <div class="secondary-nav">
          <div class="breadcrumbs-container" data-page-heading="Analytics">
            <header class="header navbar navbar-expand-sm">
              <a href="javascript:void(0);" class="btn-toggle sidebarCollapse" data-placement="bottom">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-menu">
                  <line x1="3" y1="12" x2="21" y2="12"></line>
                  <line x1="3" y1="6" x2="21" y2="6"></line>
                  <line x1="3" y1="18" x2="21" y2="18"></line>
                </svg>
              </a>
              <div class="d-flex breadcrumb-content">
                <div class="page-header">
                  <div class="page-title"></div>
                  <nav class="breadcrumb-style-one" aria-label="breadcrumb">
                    <ol class="breadcrumb">
                      <li class="breadcrumb-item active">
                        <a href="/admin/dashboard">Dashboard</a>
                      </li>
                      <li class="breadcrumb-item active" aria-current="page">
                        Sales Management
                      </li>
                    </ol>
                  </nav>
                </div>
              </div>
            </header>
          </div>
        </div>
        <!--  END BREADCRUMBS  -->

        <div class="main-content">

          <!-- Company Selection -->
          <div class="table-template mb-4">
            <div class="table-header">
              <div class="table-title">
                <h3>Sales Management</h3>
              </div>
            </div>
            <div class="table-content">
              <div class="row g-3 align-items-end">
                <div class="col-md-3">
                  <label class="form-label fw-semibold">State</label>
                  <select class="form-select" id="sales-state-filter">
                    <option value="">All States</option>
                    <% if (states && states.length > 0) { %>
                      <% states.forEach(function(s) { %>
                        <option value="<%= s.id %>"><%= s.name %></option>
                      <% }); %>
                    <% } %>
                  </select>
                </div>
                <div class="col-md-3">
                  <label class="form-label fw-semibold">City</label>
                  <select class="form-select" id="sales-city-filter">
                    <option value="">All Cities</option>
                  </select>
                </div>
                <div class="col-md-6">
                  <label for="company-select" class="form-label fw-semibold">Company</label>
                  <select class="form-select" id="company-select">
                    <option value="">Choose a company...</option>
                    <% if (companies && companies.length > 0) { %>
                      <% companies.forEach(function(company) { %>
                        <option value="<%= company.id %>"
                                data-type="<%= company.company_type %>"
                                data-company-code="<%= company.company_code %>"
                                data-state-lid="<%= company.state_lid || '' %>"
                                data-city-lid="<%= company.city_lid || '' %>">
                          <%= company.name %> (<%= company.company_code %>) &mdash; <%= company.mapped_units %> units available
                        </option>
                      <% }); %>
                    <% } else { %>
                      <option disabled>No companies with available inventory</option>
                    <% } %>
                  </select>
                  <% if (!companies || companies.length === 0) { %>
                    <small class="text-muted d-block mt-1">
                      <i class="fas fa-info-circle me-1"></i>Map inventory to companies first before processing sales.
                    </small>
                  <% } %>
                </div>
              </div>
            </div>
          </div>

          <!-- Last receipt banner -->
          <div id="last-receipt-banner" class="d-none mb-3">
            <div class="alert alert-success d-flex align-items-center justify-content-between mb-0" role="alert">
              <span>
                <i class="fas fa-check-circle me-2"></i>
                Sale complete &mdash; Receipt <strong id="last-receipt-number"></strong>
              </span>
              <a id="last-receipt-link" href="#" class="btn btn-sm btn-outline-success ms-3">
                <i class="fas fa-receipt me-1"></i> View Receipt
              </a>
            </div>
          </div>

          <!-- Inventory Table — shown after company is selected -->
          <div id="inventory-section" class="d-none">
            <div class="table-template">
              <div class="table-header">
                <div class="table-title">
                  <h3>Available Inventory</h3>
                </div>
                <div class="table-actions d-flex align-items-center gap-3">
                  <span class="badge badge-info">Selected: <span id="selected-count">0</span> units</span>
                  <span class="badge badge-success">Total: &#8377;<span id="total-value">0.00</span></span>
                  <button type="button" class="btn btn-success" id="process-sale" disabled>
                    <i class="fas fa-shopping-cart me-1"></i> Process Sale
                  </button>
                </div>
              </div>

              <div class="table-content">
                <div class="mb-3">
                  <input type="text" id="inv-search" class="form-control"
                         placeholder="Search by product name or code...">
                </div>
                <div class="table-responsive">
                  <table class="table table-bordered" id="inventory-table">
                    <thead class="table-dark">
                      <tr>
                        <th style="width: 50px;" class="text-center">
                          <input type="checkbox" id="select-all" class="form-check-input">
                        </th>
                        <th>Product</th>
                        <th>Code</th>
                        <th>Label</th>
                        <th class="text-center">Available</th>
                        <th>Price / Unit</th>
                        <th style="width: 130px;">Qty to Sell</th>
                        <th>Subtotal</th>
                      </tr>
                    </thead>
                    <tbody id="inventory-tbody">
                      <tr>
                        <td colspan="8" class="text-center py-3">
                          <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                          Loading inventory...
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </div>
                <div id="inv-pagination" class="mt-3"></div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
  <!--  END CONTENT AREA  -->
</div>
<!--  END MAIN CONTAINER  -->

<%- include ('../partials/footer') %>

<script>
$(document).ready(function() {
    // Tracks selections across pages: key = product_id + '_' + label
    // value = { isSelf, ids, availableUnits, price, quantity }
    let selectedItems    = new Map();
    let currentCompanyId = null;
    let currentIsSelf    = false;
    let currentPage      = 1;
    let currentLimit     = 25;
    let currentSearch    = '';
    let searchTimer      = null;

    // State / city / company cascade
    const salesCities = JSON.parse('<%- JSON.stringify(cities || []) %>');

    $('#sales-state-filter').on('change', function() {
        const stateId  = $(this).val();
        const citySel  = $('#sales-city-filter');
        citySel.html('<option value="">All Cities</option>');
        if (stateId) {
            salesCities.filter(c => c.state_lid == stateId).forEach(function(c) {
                citySel.append('<option value="' + c.id + '">' + c.name + '</option>');
            });
        }
        filterSalesCompanies();
    });

    $('#sales-city-filter').on('change', function() {
        filterSalesCompanies();
    });

    function filterSalesCompanies() {
        const selectedState = $('#sales-state-filter').val();
        const selectedCity  = $('#sales-city-filter').val();
        $('#company-select option').each(function() {
            if (!$(this).val()) return;
            const optState = $(this).data('state-lid');
            const optCity  = $(this).data('city-lid');
            let show = true;
            if (selectedState && optState != selectedState) show = false;
            if (selectedCity  && optCity  != selectedCity)  show = false;
            $(this).prop('hidden', !show);
        });
        const cur = $('#company-select').val();
        if (cur && $('#company-select option[value="' + cur + '"]:not([hidden])').length === 0) {
            $('#company-select').val('').trigger('change');
        }
    }

    // Company change — reset everything and load page 1
    $('#company-select').on('change', function() {
        const companyId = $(this).val();
        if (companyId) {
            selectedItems.clear();
            currentPage   = 1;
            currentSearch = '';
            $('#inv-search').val('');
            $('#inventory-section').removeClass('d-none');
            loadInventory(companyId, 1, '');
        } else {
            $('#inventory-section').addClass('d-none');
            resetSaleState();
        }
    });

    // Search with 300 ms debounce
    $('#inv-search').on('input', function() {
        clearTimeout(searchTimer);
        const q = $(this).val();
        searchTimer = setTimeout(function() {
            if (currentCompanyId) {
                currentSearch = q;
                currentPage   = 1;
                loadInventory(currentCompanyId, 1, q);
            }
        }, 300);
    });

    // Pagination click
    $(document).on('click', '#inv-pagination .page-link', function(e) {
        e.preventDefault();
        const page = parseInt($(this).data('page'));
        if (page && currentCompanyId) {
            loadInventory(currentCompanyId, page, currentSearch);
        }
    });

    $(document).on('change', '#inv-per-page', function() {
        currentLimit = parseInt($(this).val());
        if (currentCompanyId) loadInventory(currentCompanyId, 1, currentSearch);
    });

    function loadInventory(companyId, page, search) {
        currentCompanyId = companyId;
        currentPage      = page;
        currentSearch    = search;

        $('#inventory-tbody').html(
            '<tr><td colspan="8" class="text-center py-3">' +
            '<div class="spinner-border spinner-border-sm me-2" role="status"></div>Loading...</td></tr>'
        );
        $('#inv-pagination').empty();

        $.ajax({
            url: '/admin/sales/inventory/' + companyId,
            method: 'GET',
            data: { page: page, limit: currentLimit, search: search },
            success: function(response) {
                if (response.status === 200) {
                    currentIsSelf = !!response.isSelf;
                    renderInventoryTable(response.data);
                    renderPagination(response.pagination);
                    updateTotals();
                } else {
                    $('#inventory-tbody').html(
                        '<tr><td colspan="8" class="text-center text-danger py-3">' +
                        '<i class="fas fa-exclamation-circle me-1"></i>Error loading inventory</td></tr>'
                    );
                }
            },
            error: function() {
                $('#inventory-tbody').html(
                    '<tr><td colspan="8" class="text-center text-danger py-3">' +
                    '<i class="fas fa-exclamation-circle me-1"></i>Failed to load inventory</td></tr>'
                );
            }
        });
    }

    function renderInventoryTable(items) {
        const tbody = $('#inventory-tbody');
        tbody.empty();

        if (items.length === 0) {
            tbody.html(
                '<tr><td colspan="8" class="text-center py-3 text-muted">' +
                '<i class="fas fa-inbox me-1"></i>No inventory available for sale</td></tr>'
            );
            return;
        }

        items.forEach(function(item) {
            const key        = item.product_id + '_' + (item.label || 'SELF');
            const sel        = selectedItems.get(key);
            const isChecked  = !!sel;
            const qty        = sel ? sel.quantity : 1;
            const labelText  = item.label || '—';
            const labelClass = item.label === 'NEW' ? 'badge-success' : (item.label === 'OLD' ? 'badge-secondary' : 'badge-info');
            const subtotal   = isChecked ? (item.price * qty).toFixed(2) : '0.00';
            const ids        = currentIsSelf ? item.unit_ids : item.mapping_ids;

            const row =
                '<tr data-key="' + key + '"' +
                    ' data-ids=\'' + JSON.stringify(ids) + '\'' +
                    ' data-price="' + item.price + '"' +
                    ' data-available="' + item.available_units + '">' +
                    '<td class="text-center align-middle">' +
                        '<input type="checkbox" class="form-check-input item-checkbox"' + (isChecked ? ' checked' : '') + '>' +
                    '</td>' +
                    '<td class="align-middle">' + item.product_name + '</td>' +
                    '<td class="align-middle"><code>' + item.product_code + '</code></td>' +
                    '<td class="align-middle"><span class="badge ' + labelClass + '">' + labelText + '</span></td>' +
                    '<td class="align-middle text-center"><span class="badge badge-warning">' + item.available_units + '</span></td>' +
                    '<td class="align-middle"><strong>&#8377;' + parseFloat(item.price).toFixed(2) + '</strong></td>' +
                    '<td class="align-middle">' +
                        '<input type="number" class="form-control form-control-sm quantity-input" ' +
                               'min="1" max="' + item.available_units + '" value="' + qty + '"' +
                               (isChecked ? '' : ' disabled') + '>' +
                    '</td>' +
                    '<td class="align-middle"><strong>&#8377;<span class="subtotal">' + subtotal + '</span></strong></td>' +
                '</tr>';
            tbody.append(row);
        });

        // Sync select-all checkbox state for this page
        const total   = items.length;
        const checked = items.filter(i => selectedItems.has(i.product_id + '_' + (i.label || 'SELF'))).length;
        $('#select-all').prop('checked', total > 0 && checked === total);
    }

    function renderPagination(pag) {
        const container = $('#inv-pagination');
        container.empty();
        if (!pag) return;

        const limitOpts = [10, 25, 50, 100];
        let perPageSel = '<select class="form-select form-select-sm" id="inv-per-page" style="width:75px;">';
        limitOpts.forEach(function(o) {
            perPageSel += '<option value="' + o + '"' + (o === currentLimit ? ' selected' : '') + '>' + o + '</option>';
        });
        perPageSel += '</select>';

        let html = '<div class="d-flex justify-content-between align-items-center mt-1">';
        html += '<small class="text-muted">Page ' + pag.currentPage + ' of ' + pag.totalPages + ' &mdash; ' + pag.totalRecords + ' product(s) total</small>';
        html += '<div class="d-flex align-items-center gap-2">' + perPageSel + '<small class="text-muted">per page</small>';

        if (pag.totalPages > 1) {
            html += '<nav aria-label="Inventory pages"><ul class="pagination pagination-sm mb-0 ms-2">';
            html += '<li class="page-item' + (pag.hasPrevPage ? '' : ' disabled') + '">' +
                    '<a class="page-link" href="#" data-page="' + (pag.currentPage - 1) + '">Prev</a></li>';
            const start = Math.max(1, pag.currentPage - 2);
            const end   = Math.min(pag.totalPages, pag.currentPage + 2);
            for (let p = start; p <= end; p++) {
                html += '<li class="page-item' + (p === pag.currentPage ? ' active' : '') + '">' +
                        '<a class="page-link" href="#" data-page="' + p + '">' + p + '</a></li>';
            }
            html += '<li class="page-item' + (pag.hasNextPage ? '' : ' disabled') + '">' +
                    '<a class="page-link" href="#" data-page="' + (pag.currentPage + 1) + '">Next</a></li>';
            html += '</ul></nav>';
        }
        html += '</div></div>';
        container.html(html);
    }

    // Checkbox change — update selectedItems map
    $(document).on('change', '.item-checkbox', function() {
        const row      = $(this).closest('tr');
        const key      = row.data('key');
        const qtyInput = row.find('.quantity-input');

        if ($(this).is(':checked')) {
            qtyInput.prop('disabled', false);
            const qty = parseInt(qtyInput.val()) || 1;
            selectedItems.set(key, {
                ids:            row.data('ids'),
                availableUnits: parseInt(row.data('available')),
                price:          parseFloat(row.data('price')),
                quantity:       qty
            });
        } else {
            qtyInput.prop('disabled', true).val(1);
            selectedItems.delete(key);
        }
        updateTotals();
    });

    // Select all on current page
    $('#select-all').on('change', function() {
        const checked = $(this).is(':checked');
        $('.item-checkbox').each(function() {
            const row = $(this).closest('tr');
            const key = row.data('key');
            $(this).prop('checked', checked);
            const qtyInput = row.find('.quantity-input');
            if (checked) {
                qtyInput.prop('disabled', false);
                const qty = parseInt(qtyInput.val()) || 1;
                selectedItems.set(key, {
                    ids:            row.data('ids'),
                    availableUnits: parseInt(row.data('available')),
                    price:          parseFloat(row.data('price')),
                    quantity:       qty
                });
            } else {
                qtyInput.prop('disabled', true).val(1);
                selectedItems.delete(key);
            }
        });
        updateTotals();
    });

    // Quantity input — clamp and update map
    $(document).on('input', '.quantity-input', function() {
        const row = $(this).closest('tr');
        const key = row.data('key');
        const max = parseInt($(this).attr('max'));
        let val   = parseInt($(this).val());
        if (!val || val < 1) { $(this).val(1); val = 1; }
        else if (val > max)  { $(this).val(max); val = max; }
        if (selectedItems.has(key)) {
            selectedItems.get(key).quantity = val;
        }
        updateTotals();
    });

    function updateTotals() {
        let selectedCount = 0;
        let totalValue    = 0;

        selectedItems.forEach(function(item) {
            const qty = item.quantity || 1;
            selectedCount += qty;
            totalValue    += item.price * qty;
        });

        // Refresh visible subtotal cells
        $('.item-checkbox').each(function() {
            const row = $(this).closest('tr');
            const key = row.data('key');
            if ($(this).is(':checked') && selectedItems.has(key)) {
                const item = selectedItems.get(key);
                row.find('.subtotal').text((item.price * item.quantity).toFixed(2));
            } else {
                row.find('.subtotal').text('0.00');
            }
        });

        $('#selected-count').text(selectedCount);
        $('#total-value').text(totalValue.toFixed(2));
        $('#process-sale').prop('disabled', selectedCount === 0);
    }

    function resetSaleState() {
        selectedItems.clear();
        currentIsSelf = false;
        currentPage   = 1;
        currentLimit  = 25;
        currentSearch = '';
        $('#selected-count').text(0);
        $('#total-value').text('0.00');
        $('#process-sale').prop('disabled', true);
        $('#select-all').prop('checked', false);
        $('#inv-pagination').empty();
    }

    // Process sale
    $('#process-sale').on('click', function() {
        const ids = [];

        selectedItems.forEach(function(item) {
            const qty = item.quantity || 1;
            for (let i = 0; i < qty && i < item.ids.length; i++) {
                ids.push(item.ids[i]);
            }
        });

        if (ids.length === 0) return;

        const totalValue = $('#total-value').text();

        if (confirm('Process sale for ' + ids.length + ' unit(s) worth \u20B9' + totalValue + '?')) {
            const btn = $('#process-sale');
            btn.prop('disabled', true).html('<div class="spinner-border spinner-border-sm me-1" role="status"></div> Processing...');

            const url     = currentIsSelf ? '/admin/sales/sell' : '/admin/inventory-mapping/mark-as-sold';
            const payload = currentIsSelf ? { unitIds: ids } : { mappingIds: ids };

            $.ajax({
                method: 'POST',
                url:    url,
                headers: { 'Content-Type': 'application/json' },
                data: JSON.stringify(payload),
                success: function(response) {
                    if (response.status === 200) {
                        const receiptNumber = response.data.receipt_number;
                        createAlert({
                            title: 'SALE SUCCESSFUL',
                            msg: 'Successfully sold ' + response.data.total_units + ' unit(s) worth \u20B9' + parseFloat(response.data.total_amount).toFixed(2) + ' \u2014 Receipt ' + receiptNumber,
                            type: 'positive'
                        });
                        $('#last-receipt-number').text(receiptNumber);
                        $('#last-receipt-link').attr('href', '/admin/sale-receipts');
                        $('#last-receipt-banner').removeClass('d-none');
                        // Clear cart and reload current page
                        selectedItems.clear();
                        currentPage = 1;
                        $('#select-all').prop('checked', false);
                        btn.html('<i class="fas fa-shopping-cart me-1"></i> Process Sale');
                        loadInventory(currentCompanyId, 1, currentSearch);
                    } else {
                        createAlert({
                            title: 'SALE FAILED',
                            msg: response.data.message || 'Failed to process sale',
                            type: 'negative'
                        });
                        btn.prop('disabled', false).html('<i class="fas fa-shopping-cart me-1"></i> Process Sale');
                    }
                },
                error: function() {
                    createAlert({
                        title: 'ERROR',
                        msg: 'An error occurred while processing the sale',
                        type: 'negative'
                    });
                    btn.prop('disabled', false).html('<i class="fas fa-shopping-cart me-1"></i> Process Sale');
                }
            });
        }
    });
});
</script>
