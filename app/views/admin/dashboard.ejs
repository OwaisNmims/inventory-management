<style>
.section-heading {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1.2px;
  color: #888;
  padding: 4px 0 6px 2px;
  border-bottom: 1px solid rgba(0,0,0,.06);
  margin-bottom: 0;
}
.dark .section-heading { color: #aaa; border-color: rgba(255,255,255,.08); }

.dash-card-link { text-decoration: none; display: block; }
.dash-card {
  border: none;
  border-radius: 12px;
  transition: transform .15s ease, box-shadow .15s ease;
  cursor: pointer;
  height: 100%;
}
.dash-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 24px rgba(102,126,234,.18) !important;
}
.dash-card .card-body {
  padding: 20px 16px 16px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.dash-icon {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12px;
}
.dash-icon i { color: #fff; font-size: 16px; }
.dash-title {
  font-size: 13px;
  font-weight: 700;
  color: #3b3f5c;
  margin-bottom: 4px;
}
.dark .dash-title { color: #e0e6ed; }
.dash-desc {
  font-size: 11px;
  color: #888;
  margin-bottom: 0;
  line-height: 1.4;
}
.dark .dash-desc { color: #888ea8; }
</style>
