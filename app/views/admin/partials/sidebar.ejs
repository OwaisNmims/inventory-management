}

.sidebar-wrapper .submenu li a.active i,
.sidebar-wrapper .submenu li a.active .fas,
.sidebar-wrapper .submenu li a.active .far {
    color: #fff !important;
}

/* Ensure active submenu items are clearly visible */
.sidebar-wrapper .submenu li a.active::before {
    content: '';
    position: absolute;
    left: -10px;
    top: 50%;
    transform: translateY(-50%);
    width: 4px;
    height: 20px;
    background: #fff;
    border-radius: 2px;
}

/* Hover effects for non-active items */
.sidebar-wrapper .menu:not(.active) > a:hover {
    background: rgba(102, 126, 234, 0.1) !important;
    border-radius: 8px;
    transition: all 0.3s ease;
}

.sidebar-wrapper .submenu li a:not(.active):hover {
    background: rgba(102, 126, 234, 0.1) !important;
    border-radius: 6px;
    transform: translateX(3px);
    transition: all 0.3s ease;
}

/* Active parent menu indicator */
.sidebar-wrapper .menu.active > a .feather-chevron-right {
    transform: rotate(90deg);
    transition: transform 0.3s ease;
}

/* Submenu active state improvements */
