<%- include ('../partials/head') %>

<!--  BEGIN NAVBAR  -->
<%- include ('../partials/header') %>
<!--  END NAVBAR  -->

<!--  BEGIN MAIN CONTAINER  -->
<div class="main-container" id="container">
  <div class="overlay"></div>
  <div class="search-overlay"></div>

  <!--  BEGIN SIDEBAR  -->
  <%- include ('../partials/sidebar') %>
  <!--  END SIDEBAR  -->

  <!--  BEGIN CONTENT AREA  -->
  <div id="content" class="main-content">
    <div class="layout-px-spacing">
      <div class="middle-content container-xxl p-0">
        <!--  BEGIN BREADCRUMBS  -->
        <div class="secondary-nav">
          <div class="breadcrumbs-container" data-page-heading="Analytics">
            <header class="header navbar navbar-expand-sm">
              <a
                href="javascript:void(0);"
                class="btn-toggle sidebarCollapse"
                data-placement="bottom"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="feather feather-menu"
                >
                  <line x1="3" y1="12" x2="21" y2="12"></line>
                  <line x1="3" y1="6" x2="21" y2="6"></line>
                  <line x1="3" y1="18" x2="21" y2="18"></line>
                </svg>
              </a>
              <div class="d-flex breadcrumb-content">
                <div class="page-header">
                  <div class="page-title"></div>

                  <nav class="breadcrumb-style-one" aria-label="breadcrumb">
                    <ol class="breadcrumb">
                      <li class="breadcrumb-item active">
                        <a href="./masters">Master</a>
                      </li>
                      <li class="breadcrumb-item active" aria-current="page">
                        Users
                      </li>
                    </ol>
                  </nav>
                </div>
              </div>
            </header>
          </div>
        </div>
        <!--  END BREADCRUMBS  -->

        <div class="main-content">
          <div class="table-template">
            <div class="table-header">
              <div class="table-title">
                <h3>Users</h3>
              </div>
              <div class="table-actions">
                <button
                  style="background: none; border: none"
                  class="create-user-modal"
                >
                  <i class="fa-regular fa-square-plus"></i>
                </button>
              </div>
            </div>

            <div class="table-content">
              <div class="table-filter-container"></div>
              <div class="table-content">
                <div class="table-responsive">
                  <table class="table table-bordered" id="table-content">
                    <thead>
                      <tr>
                        <th scope="col">Sr No.</th>
                        <th scope="col">First Name</th>
                        <th scope="col">Last Name</th>
                        <th scope="col">Email</th>
                        <th class="text-center" scope="col">Actions</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% users.forEach((user, idx) => { %>
                      <tr data-id="<%= user.id %>">
                        <td><%- ++idx %></td>
                        <td class="user-firstname"><%- user.firstname %></td>
                        <td class="user-lastname"><%- user.lastname %></td>
                        <td class="user-email"><%- user.email %></td>
                        <td class="text-center">
                          <div class="action-btns">
                            <a
                              href="javascript:void(0);"
                              class="action-btn btn-edit bs-tooltip me-2"
                              data-toggle="tooltip"
                              data-placement="top"
                              title="Edit"
                              data-user-id="<%- user.id %>"
                            >
                              <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="feather feather-edit-2"
                              >
                                <path
                                  d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"
                                ></path>
                              </svg>
                            </a>
                            <a
                              href="javascript:void(0);"
                              class="action-btn btn-delete bs-tooltip"
                              data-toggle="tooltip"
                              data-placement="top"
                              title="Delete"
                              data-user-id="<%- user.id %>"
                            >
                              <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="feather feather-trash-2"
                              >
                                <polyline points="3 6 5 6 21 6"></polyline>
                                <path
                                  d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"
                                ></path>
                                <line x1="10" y1="11" x2="10" y2="17"></line>
                                <line x1="14" y1="11" x2="14" y2="17"></line>
                              </svg>
                            </a>
                          </div>
                        </td>
                      </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!--  END CONTENT AREA  -->
</div>
<!-- END MAIN CONTAINER -->

<!--ADD User Modal -->
<div
  class="modal fade"
  id="add-user-modal"
  tabindex="-1"
  role="dialog"
  aria-labelledby="add-user-modal"
  aria-hidden="true"
>
  <div class="modal-dialog modal-md" role="document">
    <div class="modal-content modal-inputform">
      <div class="modal-header modal-inputform-header">
        <h5 class="modal-title text-dark" id="">ADD USER</h5>
        <button
          type="button"
          class="btn fs-4 text-dark"
          data-bs-dismiss="modal"
          aria-label="Close"
        >
          <i class="fas fa-times"></i>
        </button>
      </div>
      <div class="modal-body">
        <div class="select-fields">
          <div class="mb-3">
            <label class="form-label">First Name</label>
            <input
              type="text"
              class="form-control"
              id="add-firstname"
              name="firstname"
              placeholder="Enter first name"
              required
            />
          </div>
          <div class="mb-3">
            <label class="form-label">Last Name</label>
            <input
              type="text"
              class="form-control"
              id="add-lastname"
              name="lastname"
              placeholder="Enter last name"
              required
            />
          </div>
          <div class="mb-3">
            <label class="form-label">Email</label>
            <input
              type="email"
              class="form-control"
              id="add-email"
              name="email"
              placeholder="Enter email"
              required
            />
          </div>
          <div class="mb-3">
            <label class="form-label">Password</label>
            <input
              type="password"
              class="form-control"
              id="add-password"
              name="password"
              placeholder="Enter password"
              required
            />
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary create-user">CREATE</button>
      </div>
    </div>
  </div>
</div>

<!-- Edit User Modal -->
<div
  class="modal fade"
  id="edit-user-modal"
  tabindex="-1"
  data-bs-backdrop="static"
  data-bs-keyboard="false"
  aria-labelledby="edit-user-modal"
  aria-hidden="true"
>
  <div class="modal-dialog modal-md" role="document">
    <div class="modal-content modal-inputform">
      <div class="modal-header modal-inputform-header">
        <h5 class="modal-title text-dark" id="">EDIT USER</h5>
        <button
          type="button"
          class="btn fs-4 text-dark"
          data-bs-dismiss="modal"
          aria-label="Close"
        >
          <i class="fas fa-times"></i>
        </button>
      </div>
      <div class="modal-body">
        <div class="select-fields">
          <div class="mb-3">
            <label class="form-label" for="edit-firstname">First Name</label>
            <input type="text" class="form-control" id="edit-firstname" required />
          </div>
          <div class="mb-3">
            <label class="form-label" for="edit-lastname">Last Name</label>
            <input type="text" class="form-control" id="edit-lastname" required />
          </div>
          <div class="mb-3">
            <label class="form-label" for="edit-email">Email</label>
            <input type="email" class="form-control" id="edit-email" required />
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-warning change-password-btn">Change Password</button>
        <button type="button" id="save-edited-user" class="btn btn-primary">SAVE</button>
      </div>
    </div>
  </div>
</div>

<!-- Change Password Modal -->
<div
  class="modal fade"
  id="change-password-modal"
  tabindex="-1"
  data-bs-backdrop="static"
  data-bs-keyboard="false"
  aria-labelledby="change-password-modal"
  aria-hidden="true"
>
  <div class="modal-dialog modal-md" role="document">
    <div class="modal-content modal-inputform">
      <div class="modal-header modal-inputform-header">
        <h5 class="modal-title text-dark" id="">CHANGE PASSWORD</h5>
        <button
          type="button"
          class="btn fs-4 text-dark"
          data-bs-dismiss="modal"
          aria-label="Close"
        >
          <i class="fas fa-times"></i>
        </button>
      </div>
      <div class="modal-body">
        <div class="select-fields">
          <div class="mb-3">
            <label class="form-label" for="new-password">New Password</label>
            <input type="password" class="form-control" id="new-password" required />
          </div>
          <div class="mb-3">
            <label class="form-label" for="confirm-password">Confirm Password</label>
            <input type="password" class="form-control" id="confirm-password" required />
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" id="save-new-password" class="btn btn-primary">UPDATE PASSWORD</button>
      </div>
    </div>
  </div>
</div>

  <%- include ('../partials/footer') %>

  <!-- CUSTOM JS SCRIPT -->
  <script>
    $(document).ready(function () {
      // GLOBAL VARIABLES
      let currentUserId;

      // Show Add User Modal
      $(".create-user-modal").on("click", function () {
        $("#add-user-modal").modal("show");
      });

      // CREATE USER
      $(".create-user").on("click", function () {
        const firstname = $("#add-firstname").val().trim();
        const lastname = $("#add-lastname").val().trim();
        const email = $("#add-email").val().trim();
        const password = $("#add-password").val();

        // Validation
        if (!firstname || !lastname || !email || !password) {
          createAlert({
            title: "Validation Error!",
            msg: "All fields are required.",
            type: "negative",
          });
          return false;
        }

        // Email validation
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(email)) {
          createAlert({
            title: "Validation Error!",
            msg: "Please enter a valid email address.",
            type: "negative",
          });
          return false;
        }

        // Password validation (min 6 characters)
        if (password.length < 6) {
          createAlert({
            title: "Validation Error!",
            msg: "Password must be at least 6 characters long.",
            type: "negative",
          });
          return false;
        }

        $.ajax({
          method: "POST",
          url: "/admin/users/insert",
          data: { firstname, lastname, email, password },
          success: function (response) {
            if (response.message === 'success') {
              createAlert({
                title: "Success!",
                msg: "User created successfully.",
                type: "positive",
              });
              setTimeout(() => location.reload(), 1500);
            } else {
              createAlert({
                title: "ERROR",
                msg: response.data?.message || "Failed to create user.",
                type: "negative",
              });
            }
          },
          error: function (xhr) {
            const errorMsg = xhr.responseJSON?.data?.message || xhr.responseText || "Something went wrong!";
            createAlert({
              title: "ERROR",
              msg: errorMsg,
              type: "negative",
            });
          },
        });
      });

      // EDIT USER - Open Modal
      $(document).on("click", ".btn-edit", function () {
        currentUserId = $(this).data("user-id");
        const thisTr = $(this).closest("tr");
        const firstname = $(thisTr).find(".user-firstname").text();
        const lastname = $(thisTr).find(".user-lastname").text();
        const email = $(thisTr).find(".user-email").text();

        $("#edit-firstname").val(firstname);
        $("#edit-lastname").val(lastname);
        $("#edit-email").val(email);
        $("#edit-user-modal").modal("show");
      });

      // SAVE EDITED USER
      $("#save-edited-user").on("click", function () {
        const firstname = $("#edit-firstname").val().trim();
        const lastname = $("#edit-lastname").val().trim();
        const email = $("#edit-email").val().trim();

        // Validation
        if (!firstname || !lastname || !email) {
          createAlert({
            title: "Validation Error!",
            msg: "All fields are required.",
            type: "negative",
          });
          return false;
        }

        // Email validation
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(email)) {
          createAlert({
            title: "Validation Error!",
            msg: "Please enter a valid email address.",
            type: "negative",
          });
          return false;
        }

        $.ajax({
          method: "POST",
          url: "/admin/users/update",
          data: { userId: currentUserId, firstname, lastname, email },
          success: function (response) {
            if (response.message === 'success') {
              createAlert({
                title: "Success!",
                msg: "User updated successfully.",
                type: "positive",
              });
              setTimeout(() => location.reload(), 1500);
            } else {
              createAlert({
                title: "ERROR",
                msg: response.data?.message || "Failed to update user.",
                type: "negative",
              });
            }
          },
          error: function (xhr) {
            const errorMsg = xhr.responseJSON?.data?.message || xhr.responseText || "Something went wrong!";
            createAlert({
              title: "ERROR",
              msg: errorMsg,
              type: "negative",
            });
          },
        });
      });

      // CHANGE PASSWORD - Open Modal
      $(".change-password-btn").on("click", function () {
        $("#edit-user-modal").modal("hide");
        $("#change-password-modal").modal("show");
      });

      // SAVE NEW PASSWORD
      $("#save-new-password").on("click", function () {
        const newPassword = $("#new-password").val();
        const confirmPassword = $("#confirm-password").val();

        // Validation
        if (!newPassword || !confirmPassword) {
          createAlert({
            title: "Validation Error!",
            msg: "Both password fields are required.",
            type: "negative",
          });
          return false;
        }

        if (newPassword.length < 6) {
          createAlert({
            title: "Validation Error!",
            msg: "Password must be at least 6 characters long.",
            type: "negative",
          });
          return false;
        }

        if (newPassword !== confirmPassword) {
          createAlert({
            title: "Validation Error!",
            msg: "Passwords do not match.",
            type: "negative",
          });
          return false;
        }

        $.ajax({
          method: "POST",
          url: "/admin/users/update-password",
          data: { userId: currentUserId, newPassword },
          success: function (response) {
            if (response.message === 'success') {
              createAlert({
                title: "Success!",
                msg: "Password updated successfully.",
                type: "positive",
              });
              $("#change-password-modal").modal("hide");
              $("#new-password").val("");
              $("#confirm-password").val("");
            } else {
              createAlert({
                title: "ERROR",
                msg: response.data?.message || "Failed to update password.",
                type: "negative",
              });
            }
          },
          error: function (xhr) {
            const errorMsg = xhr.responseJSON?.data?.message || xhr.responseText || "Something went wrong!";
            createAlert({
              title: "ERROR",
              msg: errorMsg,
              type: "negative",
            });
          },
        });
      });

      // DELETE USER
      $(document).on("click", ".btn-delete", function () {
        const userId = $(this).data("user-id");

        const isConfirmed = confirm(
          "Are you sure you want to delete this user? This action cannot be undone."
        );

        if (!isConfirmed) {
          return false;
        }

        $.ajax({
          method: "POST",
          url: "/admin/users/delete",
          data: { userId },
          success: function (response) {
            if (response.message === 'success') {
              createAlert({
                title: "Success!",
                msg: "User deleted successfully.",
                type: "positive",
              });
              setTimeout(() => location.reload(), 1500);
            } else {
              createAlert({
                title: "ERROR",
                msg: response.data?.message || "Failed to delete user.",
                type: "negative",
              });
            }
          },
          error: function (xhr) {
            const errorMsg = xhr.responseJSON?.data?.message || xhr.responseText || "Something went wrong!";
            createAlert({
              title: "ERROR",
              msg: errorMsg,
              type: "negative",
            });
          },
        });
      });

      // Clear modal fields when closed
      $("#add-user-modal").on("hidden.bs.modal", function () {
        $("#add-firstname, #add-lastname, #add-email, #add-password").val("");
      });

      $("#change-password-modal").on("hidden.bs.modal", function () {
        $("#new-password, #confirm-password").val("");
      });
    });
  </script>
  <!--END CUSTOM JS SCRIPT -->

  <%- include ('../partials/footer-end') %>
</div>
