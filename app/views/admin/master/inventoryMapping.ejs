<%- include ('../partials/footer') %>

<!-- Pagination Script -->
<script src="/js/pagination.js"></script>

<!-- CUSTOM JS SCRIPT -->
<script>
$(document).ready(function() {
  
  // Initialize Bootstrap tooltips
  var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
  var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
    return new bootstrap.Tooltip(tooltipTriggerEl);
  });
  
  // Filters are now handled by server-side pagination (removed client-side filtering)

  // Show create mapping modal with fresh data
  $('.create-mapping-modal').on('click', function() {
    // Refresh available inventory data before showing modal
    refreshAvailableInventory();
    $('#create-mapping-modal').modal('show');
  });

  // Initialize pagination managers
  let mainMappingsPagination;
  let availableInventoryPagination;

  // City data for cascading dropdowns
  const mappingCities = JSON.parse('<%- JSON.stringify(cities || []) %>');

  // Helper function to populate city dropdown based on state (for main filter)
  function updateCityFilter(stateId) {
    const citySelect = $('#city-filter');
    citySelect.html('<option value="">All Cities</option>');
    
    if (stateId) {
      const filteredCities = mappingCities.filter(city => city.state_lid == stateId);
      filteredCities.forEach(city => {
        citySelect.append(`<option value="${city.id}">${city.name}</option>`);
      });
    }
  }

  // Helper function to populate city dropdown for mapping modal
  function updateMappingCityFilter(stateId) {
    const citySelect = $('#mapping-city');
    citySelect.html('<option value="">All Cities</option>');
    
    if (stateId) {
      const filteredCities = mappingCities.filter(city => city.state_lid == stateId);
      filteredCities.forEach(city => {
        citySelect.append(`<option value="${city.id}">${city.name}</option>`);
      });
    }
  }

  // Helper function to filter company dropdown based on state/city
  function filterMappingCompanies() {
    const selectedState = $('#mapping-state').val();
    const selectedCity = $('#mapping-city').val();
    const companySelect = $('#mapping-company');
    
    // Show all options first
    companySelect.find('option').each(function() {
      if ($(this).val() === '') return; // Skip the placeholder option
      
      const companyState = $(this).data('state-lid');
      const companyCity = $(this).data('city-lid');
      
      let shouldShow = true;
      
      // Filter by state if selected
      if (selectedState && companyState != selectedState) {
        shouldShow = false;
      }
      
      // Filter by city if selected
      if (selectedCity && companyCity != selectedCity) {
        shouldShow = false;
      }
      
      if (shouldShow) {
        $(this).show();
      } else {
        $(this).hide();
      }
    });
    
    // Reset company selection if current selection is now hidden
    const currentCompany = companySelect.val();
    if (currentCompany && companySelect.find(`option[value="${currentCompany}"]:visible`).length === 0) {
      companySelect.val('');
    }
  }

  // Initialize pagination after DOM is ready
  function initializePagination() {
    console.log('Initializing pagination...');
    
    // Check if pagination components exist
    if ($('#main-mappings-pagination').length === 0) {
      console.error('Main pagination container not found');
      return;
    }
    
    if ($('#available-inventory-pagination').length === 0) {
      console.error('Available inventory pagination container not found');
      return;
    }

    // Initialize main mappings pagination
    mainMappingsPagination = new InventoryPaginationManager({
      containerId: 'main-mappings-pagination',
      apiUrl: '/admin/inventory-mapping/grouped',
      pageSize: 20,
      searchInputId: '#main-mappings-search',
      sortBy: 'product_name',
      sortOrder: 'ASC',
      filters: {
        state: '#state-filter',
        city: '#city-filter',
        company: '#company-filter',
        product: '#product-filter'
      },
      onDataLoad: function(data) {
        const tbody = $('#mappings-tbody');
        tbody.empty();
        
        if (data.items.length === 0) {
          tbody.html(`
            <tr>
              <td colspan="13" class="text-center">No mappings found</td>
            </tr>
          `);
      } else {
          data.items.forEach(function(group) {
            tbody.append(`
              <tr data-product-id="${group.product_id}" data-company-id="${group.company_id}" data-product="${group.product_name}" data-company="${group.company_name}">
                <td class="product-name"><strong>${group.product_name}</strong></td>
                <td>${group.product_code}</td>
                <td>${group.company_name}</td>
                <td>
                  <span class="badge ${group.company_type === 'SELF' ? 'badge-primary' : group.company_type === 'VENDOR' ? 'badge-warning' : 'badge-info'}">
                    ${group.company_type}
                  </span>
                </td>
                <td><span class="badge badge-info fs-6">${group.total_units}</span></td>
                <td><span class="badge badge-success">${group.available_units}</span></td>
                <td><span class="badge badge-warning">${group.mapped_units}</span></td>
                <td><span class="badge badge-danger">${group.sold_units}</span></td>
                <td><span class="badge badge-success">${group.new_stock || 0}</span></td>
                <td><span class="badge badge-secondary">${group.old_stock || 0}</span></td>
                <td><strong>₹${parseFloat(group.total_value || 0).toFixed(2)}</strong></td>
                <td>${new Date(group.first_mapped_at).toLocaleDateString()}</td>
                <td class="text-center">
                  <div class="action-btns">
                    <button class="btn btn-sm btn-outline-info btn-view-details" 
                            data-product-id="${group.product_id}" 
                            data-company-id="${group.company_id}"
                            data-product-name="${group.product_name}"
                            data-company-name="${group.company_name}"
                            title="View individual units for ${group.product_name} at ${group.company_name}"
                            data-bs-toggle="tooltip" 
                            data-bs-placement="top">
                      <i class="fas fa-list"></i> View Units
                    </button>
                  </div>
                </td>
              </tr>
            `);
          });
        }
        
        // Update bulk actions
        updateBulkActions();
      },
      onError: function(message) {
        $('#mappings-tbody').html(`
          <tr>
            <td colspan="12" class="text-center text-danger">${message}</td>
          </tr>
        `);
      }
    });

    // Initialize products pagination for modal (quantity-based)
    availableInventoryPagination = new InventoryPaginationManager({
      containerId: 'available-inventory-pagination',
      apiUrl: '/admin/inventory-mapping/products-for-mapping',
      pageSize: 20,
      searchInputId: '#inventory-search',
      sortBy: 'p.name',
      sortOrder: 'ASC',
      onDataLoad: function(data) {
        const tbody = $('#available-inventory-list');
        tbody.empty();
        
        if (data.items.length === 0) {
          tbody.html(`
            <tr>
              <td colspan="5" class="text-center">No products with available inventory found</td>
            </tr>
          `);
        } else {
          data.items.forEach(function(product) {
            tbody.append(`
              <tr>
                <td><strong>${product.product_name}</strong></td>
                <td>${product.product_code}</td>
                <td><span class="badge bg-info">${product.available_units}</span></td>
                <td><strong>₹${parseFloat(product.price || 0).toFixed(2)}</strong></td>
                <td>
                  <input type="number" 
                         class="form-control form-control-sm quantity-input" 
                         data-product-id="${product.product_id}"
                         data-product-name="${product.product_name}"
                         data-product-code="${product.product_code}"
                         data-max="${product.available_units}"
                         min="0" 
                         max="${product.available_units}" 
                         value="0"
                         placeholder="0">
                </td>
              </tr>
            `);
          });
          
          // Update mapping when quantity changes
          $('.quantity-input').on('input', function() {
            const max = parseInt($(this).data('max'));
            const val = parseInt($(this).val()) || 0;
            
            // Enforce max
            if (val > max) {
              $(this).val(max);
            }
            
            // Update selected count
            updateQuantityBasedSelection();
          });
        }
      },
      onError: function(message) {
        $('#available-inventory-list').html(`
          <tr>
            <td colspan="5" class="text-center text-danger">${message}</td>
          </tr>
        `);
      }
    });
    
    console.log('Pagination initialized successfully');
  }

  // Initialize pagination after a short delay to ensure DOM is ready
  setTimeout(initializePagination, 100);

  // Function to refresh available inventory data (backward compatibility)
  function refreshAvailableInventory() {
    availableInventoryPagination.refresh();
  }

  // Select all checkboxes
  $('#select-all').on('change', function() {
    $('.mapping-checkbox').prop('checked', $(this).prop('checked'));
    updateBulkActions();
  });

  // Quantity-based selection (replaced checkbox logic)
  function updateQuantityBasedSelection() {
    // No longer needed - just used for future extensions
  }

  // Update bulk actions based on selection
  $('.mapping-checkbox').on('change', function() {
    updateBulkActions();
  });

  function updateBulkActions() {
    const selectedCount = $('.mapping-checkbox:checked').length;
    let totalValue = 0;
    
    $('.mapping-checkbox:checked').each(function() {
      const row = $(this).closest('tr');
      const priceText = row.find('td:eq(4)').text().replace('₹', '');
      const price = parseFloat(priceText) || 0;
      totalValue += price;
    });
    
    $('#selected-count').text(selectedCount);
    $('#selected-value').text(totalValue.toFixed(2));
  }

  // Clear filters button - now resets pagination
  // State filter change handler - cascade to city
  $('#state-filter').on('change', function() {
    const stateId = $(this).val();
    updateCityFilter(stateId);
    
    if (mainMappingsPagination) {
      mainMappingsPagination.handleFilterChange();
    }
  });

  // City filter change handler
  $('#city-filter').on('change', function() {
    if (mainMappingsPagination) {
      mainMappingsPagination.handleFilterChange();
    }
  });

  $('#clear-filters').on('click', function() {
    $('#state-filter').val('');
    $('#city-filter').html('<option value="">All Cities</option>');
    $('#company-filter').val('');
    $('#product-filter').val('');
    
    if (mainMappingsPagination) {
      mainMappingsPagination.reset();
    }
  });
  
  // Product filter with debouncing (like search)
  let productFilterTimeout;
  $('#product-filter').on('input', function() {
    clearTimeout(productFilterTimeout);
    productFilterTimeout = setTimeout(function() {
      if (mainMappingsPagination) {
        mainMappingsPagination.handleFilterChange();
      }
    }, 500);
  });

  // View Units Modal
  let currentViewUnitsData = {
    productId: null,
    companyId: null,
    productName: '',
    companyName: '',
    unitPrice: 0,
    totalUnits: 0,
    availableUnits: 0,
    mappedUnits: 0,
    soldUnits: 0
  };

  let unitsDetailPagination = null;

  // Open View Units Modal
  $(document).on('click', '.btn-view-details', function() {
    const productId = $(this).data('product-id');
    const companyId = $(this).data('company-id');
    const productName = $(this).data('product-name');
    const companyName = $(this).data('company-name');

    currentViewUnitsData = { 
      productId, 
      companyId, 
      productName, 
      companyName, 
      unitPrice: 0,
      totalUnits: 0,
      availableUnits: 0,
      mappedUnits: 0,
      soldUnits: 0
    };

    $('#modal-product-name').text(productName);
    $('#modal-company-name').text(companyName);
    
    // Initialize or refresh pagination for units
    initializeUnitsDetailPagination();
    
    $('#view-units-modal').modal('show');
  });

  // Initialize units detail pagination
  function initializeUnitsDetailPagination() {
    // Always destroy and recreate to ensure fresh filters
    if (unitsDetailPagination) {
      unitsDetailPagination = null;
    }

    // Create a custom loadData function that always includes product and company filters
    const productName = currentViewUnitsData.productName;
    const companyName = currentViewUnitsData.companyName;

    unitsDetailPagination = new InventoryPaginationManager({
      containerId: 'units-detail-pagination',
      apiUrl: '/admin/inventory-mapping/paginated',
      pageSize: 20,
      searchInputId: '#units-detail-search',
      sortBy: 'iu.id',
      sortOrder: 'ASC',
      customParams: {
        product: productName,
        company: companyName,
        exactProduct: true  // Force exact match
      },
      filters: {}, // No dynamic filters needed - using customParams
      onDataLoad: function(data) {
        console.log('Modal onDataLoad - Received items:', data.items.length);
        console.log('Modal onDataLoad - Sample items:', data.items.slice(0, 3).map(i => ({
          id: i.inventory_id,
          product: i.product_name,
          company: i.company_name
        })));
        
        const tbody = $('#units-detail-tbody');
        tbody.empty();
        
        // Update summary with total counts from pagination metadata
        if (data.pagination) {
          currentViewUnitsData.totalUnits = data.pagination.totalRecords;
        }
        
        // Get unit price from first unit
        if (data.items.length > 0) {
          currentViewUnitsData.unitPrice = parseFloat(data.items[0].price) || 0;
          $('#unit-price').text(currentViewUnitsData.unitPrice.toFixed(2));
          
          // Calculate counts from all items
          currentViewUnitsData.availableUnits = data.items.filter(u => u.status === 'AVAILABLE').length;
          currentViewUnitsData.mappedUnits = data.items.filter(u => u.status === 'MAPPED').length;
          currentViewUnitsData.soldUnits = data.items.filter(u => u.status === 'SOLD').length;
        }
        
        // Update summary cards
        updateUnitsSummaryFromData(data);
        
        if (data.items.length === 0) {
          tbody.html('<tr><td colspan="7" class="text-center">No units found</td></tr>');
          return;
        }

        data.items.forEach(function(unit) {
          tbody.append(`
            <tr>
              <td><strong>#${unit.inventory_id}</strong></td>
              <td>${unit.product_code}</td>
              <td><strong>₹${parseFloat(unit.price || 0).toFixed(2)}</strong></td>
              <td>
                <span class="badge ${unit.label === 'NEW' ? 'badge-success' : unit.label === 'OLD' ? 'badge-secondary' : 'badge-danger'}">
                  ${unit.label}
                </span>
              </td>
              <td>
                <span class="badge ${unit.status === 'AVAILABLE' ? 'badge-success' : unit.status === 'MAPPED' ? 'badge-warning' : 'badge-danger'}">
                  ${unit.status}
                </span>
              </td>
              <td>${new Date(unit.mapped_at).toLocaleDateString()}</td>
              <td>${unit.notes || '-'}</td>
            </tr>
          `);
        });
      },
      onError: function(message) {
        $('#units-detail-tbody').html(`
          <tr>
            <td colspan="7" class="text-center text-danger">${message}</td>
          </tr>
        `);
      }
    });
  }

  // Update units summary from paginated data
  function updateUnitsSummaryFromData(data) {
    // We need to get total counts for all statuses, not just current page
    // Make a quick summary request with exact matching
    $.ajax({
      url: '/admin/inventory-mapping/paginated',
      method: 'GET',
      data: {
        product: currentViewUnitsData.productName,
        company: currentViewUnitsData.companyName,
        exactProduct: true,  // Force exact match
        limit: 1000 // Get all for counting
      },
      success: function(response) {
        if (response.status === 200 && response.data.items) {
          const units = response.data.items;
          const total = units.length;
          const available = units.filter(u => u.status === 'AVAILABLE').length;
          const mapped = units.filter(u => u.status === 'MAPPED').length;
          const sold = units.filter(u => u.status === 'SOLD').length;

          $('#units-total').text(total);
          $('#units-available').text(available);
          $('#units-mapped').text(mapped);
          $('#units-sold').text(sold);

        }
      }
    });
  }

  // Reset modal when opened
  // Mapping modal state filter change handler
  $('#mapping-state').on('change', function() {
    const stateId = $(this).val();
    updateMappingCityFilter(stateId);
    filterMappingCompanies();
  });

  // Mapping modal city filter change handler
  $('#mapping-city').on('change', function() {
    filterMappingCompanies();
  });

  $('#create-mapping-modal').on('show.bs.modal', function() {
    // Clear form
    $('#mapping-state').val('');
    $('#mapping-city').html('<option value="">All Cities</option>');
    $('#mapping-company').val('');
    $('#mapping-company option').show(); // Show all companies
    $('#mapping-notes').val('');
    
    // Reset all quantity inputs
    $('.quantity-input').val(0);
    
    // Reset pagination
    if (availableInventoryPagination) {
      availableInventoryPagination.reset();
    }
  });

  // Create mapping with quantity-based selection
  $('.create-mapping').on('click', function() {
    const companyId = $('#mapping-company').val();
    const notes = $('#mapping-notes').val();
    const productQuantities = [];

    // Get all products with quantity > 0
    $('.quantity-input').each(function() {
      const quantity = parseInt($(this).val()) || 0;
      if (quantity > 0) {
        productQuantities.push({
          productId: $(this).data('product-id'),
          productName: $(this).data('product-name'),
          quantity: quantity
        });
      }
    });

    if (!companyId) {
      createAlert({
        title: 'ERROR',
        msg: 'Please select a company',
        type: 'negative'
      });
      return;
    }

    if (productQuantities.length === 0) {
      createAlert({
        title: 'ERROR',
        msg: 'Please enter at least one product quantity',
        type: 'negative'
      });
      return;
    }

    // Show confirmation with details
    const companyName = $('#mapping-company option:selected').text();
    const totalUnits = productQuantities.reduce((sum, p) => sum + p.quantity, 0);
    
    if (!confirm(`Create mapping for ${totalUnits} unit(s) across ${productQuantities.length} product(s) to ${companyName}?`)) {
      return;
    }

    // Disable button during request
    $(this).prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Creating...');

    $.ajax({
      method: "POST",
      url: "/admin/inventory-mapping/create",
      headers: { 'Content-Type': 'application/json' },
      data: JSON.stringify({
        productQuantities: productQuantities,
        companyId: companyId,
        notes: notes
      }),
      success: function(response) {
        if (response.status === 200) {
          createAlert({
            title: "SUCCESS",
            msg: response.data.message,
            type: "positive",
          });
          setTimeout(() => {
            location.reload();
          }, 2000);
        } else {
          createAlert({
            title: "ERROR",
            msg: response.data.message,
            type: "negative",
          });
        }
        $('#create-mapping-modal').modal('hide');
      },
      error: function(xhr, status, error) {
        let errorMessage = "Something went wrong!";
        
        // Try to parse the error response
        if (xhr.responseJSON && xhr.responseJSON.data && xhr.responseJSON.data.message) {
          errorMessage = xhr.responseJSON.data.message;
        } else if (xhr.responseText) {
          try {
            const errorResponse = JSON.parse(xhr.responseText);
            if (errorResponse.data && errorResponse.data.message) {
              errorMessage = errorResponse.data.message;
            }
          } catch (e) {
            errorMessage = xhr.statusText || errorMessage;
          }
        }
        
        createAlert({
          title: "ERROR",
          msg: errorMessage,
          type: "negative",
        });
        $('#create-mapping-modal').modal('hide');
      },
      complete: function() {
        // Re-enable button
        $('.create-mapping').prop('disabled', false).html('Create Mapping');
      }
    });
  });

  // View details
  $(document).on('click', '.btn-details', function() {
    const mappingId = $(this).data('id');
    const row = $(this).closest('tr');
    
    // Populate modal with data from the table row
    $('#view-inventory-id').text(row.find('td:eq(1)').text());
    $('#view-product-name').text(row.find('td:eq(2)').text());
    $('#view-product-code').text(row.find('td:eq(3)').text());
    $('#view-product-category').text(row.find('td:eq(4)').text() || '-');
    $('#view-product-price').text(row.find('td:eq(5)').text());
    $('#view-product-company').text(row.find('td:eq(6)').text());
    $('#view-product-status').text(row.find('td:eq(7)').text());
    $('#view-inventory-label').text(row.find('td:eq(8)').text());
    $('#view-mapped-date').text(row.find('td:eq(9)').text());
    $('#view-notes').text(row.find('td:eq(10)').text() || '-');
    
    // For description and specifications, show placeholder since not available in table
    $('#view-product-description').text('Product description not available in current view');
    $('#view-product-specifications').text('Product specifications not available in current view');
    
    // Show the modal
    $('#product-view-modal').modal('show');
  });

  // ── Column sorting for main mapping table ──────────────────────
  let mappingCurrentSort  = 'product_name';
  let mappingCurrentOrder = 'ASC';

  $(document).on('click', '#mapping-table thead .sortable', function() {
    const field = $(this).data('sort');
    if (mappingCurrentSort === field) {
      mappingCurrentOrder = mappingCurrentOrder === 'ASC' ? 'DESC' : 'ASC';
    } else {
      mappingCurrentSort  = field;
      mappingCurrentOrder = 'ASC';
    }

    // Update icons
    $('#mapping-table thead .sortable .sort-icon')
      .removeClass('fa-sort-up fa-sort-down').addClass('fa-sort');
    $(this).find('.sort-icon')
      .removeClass('fa-sort')
      .addClass(mappingCurrentOrder === 'ASC' ? 'fa-sort-up' : 'fa-sort-down');

    // Push new sort into the pagination manager and reload from page 1
    if (mainMappingsPagination) {
      mainMappingsPagination.config.sortBy    = mappingCurrentSort;
      mainMappingsPagination.config.sortOrder = mappingCurrentOrder;
      mainMappingsPagination.currentPage = 1;
      mainMappingsPagination.refresh();
    }
  });
});
</script><!--END CUSTOM JS SCRIPT -->

<style>
#mapping-table thead .sortable {
  cursor: pointer;
  user-select: none;
  white-space: nowrap;
}
#mapping-table thead .sortable:hover { background: rgba(255,255,255,.08); }
#mapping-table thead .sort-icon { font-size: 11px; opacity: .6; }
#mapping-table thead .sortable .fa-sort-up,
#mapping-table thead .sortable .fa-sort-down { opacity: 1; color: #ffd700; }
</style>

<%- include ('../partials/footer-end') %>
